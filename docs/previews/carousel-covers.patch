index 0000000..686f67e
--- /dev/null
+++ b/app/data/banners.ts
@@ -0,0 +1,34 @@
+/**
+ * The cover drawn at the top of a server's card in a carousel, per game,
+ * until servers can upload banners of their own.
+ *
+ * Drawn entirely by CSS from two colours and a short mark: no game's logo or
+ * artwork, which belong to their publishers. The colours only nod to each
+ * game's usual look so a strip of cards reads at a glance.
+ */
+export interface Banner {
+  /** The big faint text across the cover. */
+  mark: string
+  /** Light and dark ends of the cover's colour. */
+  from: string
+  to: string
+}
+
+export const BANNERS: Record<string, Banner> = {
+  lineage2: { mark: 'L2', from: '#f5b041', to: '#5c2a06' },
+  wow: { mark: 'WoW', from: '#4aa8ff', to: '#0c2257' },
+  mu: { mark: 'MU', from: '#ff5470', to: '#4c0819' },
+  aion: { mark: 'AION', from: '#a77bff', to: '#0f5c78' },
+  pw: { mark: 'PW', from: '#2fd69a', to: '#0b3f45' },
+  rf: { mark: 'RF', from: '#ff8a2b', to: '#1f2d3d' },
+  sro: { mark: 'SRO', from: '#e9bb62', to: '#6b1a1a' },
+  metin2: { mark: 'MT2', from: '#46d39b', to: '#11241c' },
+  rappelz: { mark: 'RZ', from: '#ff6fd8', to: '#341760' },
+  tibia: { mark: 'TIBIA', from: '#9ccc4a', to: '#3a2812' }
+}
+
+const FALLBACK: Banner = { mark: '', from: '#9c5cff', to: '#1b1240' }
+
+export function bannerFor(game: string): Banner {
+  return BANNERS[game] ?? FALLBACK
+}
