diff --git a/app/assets/css/main.css b/app/assets/css/main.css
index 5922521..74ac255 100644
--- a/app/assets/css/main.css
+++ b/app/assets/css/main.css
@@ -1629,6 +1629,59 @@ html.theme-light::-webkit-scrollbar-thumb:hover {
   box-shadow: inset 0 0 0 1px #fff;
 }
 
+/* Each game's own colour on its servers' badges: tinted ground, a frame in
+   the colour, the letters a pale tint of it. The rest of the row keeps the
+   panel's colours, so the badge alone tells the games apart down a list. */
+[data-game="lineage2"] { --game: #e8b04b; }
+[data-game="wow"] { --game: #4aa8ff; }
+[data-game="mu"] { --game: #ff5c6c; }
+[data-game="aion"] { --game: #2fd4c4; }
+[data-game="pw"] { --game: #a98bff; }
+[data-game="rf"] { --game: #ff8b3d; }
+[data-game="sro"] { --game: #3ed688; }
+[data-game="metin2"] { --game: #b5e04a; }
+[data-game="rappelz"] { --game: #ff70c0; }
+[data-game="tibia"] { --game: #d4a373; }
+
+.game-logo[data-game] {
+  background: linear-gradient(135deg, color-mix(in srgb, var(--game) 40%, #171b27), color-mix(in srgb, var(--game) 14%, #0d1018));
+  border-color: color-mix(in srgb, var(--game) 90%, transparent);
+  color: color-mix(in srgb, var(--game) 30%, #fff);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .05), 0 0 14px color-mix(in srgb, var(--game) 35%, transparent);
+}
+
+.theme-light .game-logo[data-game] {
+  background: linear-gradient(135deg, color-mix(in srgb, var(--game) 16%, #fff), color-mix(in srgb, var(--game) 26%, #fff));
+  border-color: color-mix(in srgb, var(--game) 70%, #fff);
+  color: color-mix(in srgb, var(--game) 45%, #10121f);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .6);
+}
+
+/* A stripe of the game's colour down the row's leading edge. */
+.game-row[data-game] { box-shadow: inset 3px 0 0 var(--game); }
+[dir="rtl"] .game-row[data-game] { box-shadow: inset -3px 0 0 var(--game); }
+
+/* The game tabs: a dot of each game's colour before its name, and the chosen
+   tab tinted and underlined in it rather than in the site's purple. */
+.category[data-game]::before {
+  content: "";
+  width: 8px;
+  height: 8px;
+  margin-inline-end: 8px;
+  border-radius: 50%;
+  background: var(--game);
+  box-shadow: 0 0 8px color-mix(in srgb, var(--game) 60%, transparent);
+}
+.category.active[data-game] {
+  background: linear-gradient(180deg, color-mix(in srgb, var(--game) 30%, transparent), color-mix(in srgb, var(--game) 10%, transparent));
+  box-shadow: inset 0 -2px 0 var(--game);
+}
+.theme-light .category.active[data-game] {
+  color: color-mix(in srgb, var(--game) 40%, #10121f);
+  background: linear-gradient(180deg, color-mix(in srgb, var(--game) 30%, #fff), color-mix(in srgb, var(--game) 18%, #fff));
+  box-shadow: inset 0 -2px 0 var(--game);
+}
+
 .game-name {
   min-width: 0;
   display: flex;
