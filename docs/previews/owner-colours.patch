diff --git a/app/data/looks.ts b/app/data/looks.ts
new file mode 100644
index 0000000..951bf71
--- /dev/null
+++ b/app/data/looks.ts
@@ -0,0 +1,42 @@
+/**
+ * The colours a server's owner may pick for the server's own badge and card
+ * (its row in a list, its card in a carousel). A fixed palette rather than
+ * any colour: each is bright enough to read on the dark theme and is mixed
+ * down to a tint for the light one, so text over it always stays readable.
+ */
+export const SWATCHES = {
+  gold: '#e8b04b',
+  orange: '#ff8b3d',
+  red: '#ff5c6c',
+  pink: '#ff70c0',
+  violet: '#a98bff',
+  blue: '#4aa8ff',
+  teal: '#2fd4c4',
+  green: '#3ed688',
+  lime: '#b5e04a',
+  silver: '#c9cfdf'
+} as const
+export type Swatch = keyof typeof SWATCHES
+
+/** What the owner chose; anything left out keeps the site's own look. */
+export interface ServerLook {
+  badge?: Swatch
+  badgeBorder?: Swatch
+  card?: Swatch
+  cardBorder?: Swatch
+}
+
+/** The look as CSS custom properties and the classes that use them. */
+export function lookStyle(look: ServerLook | undefined) {
+  if (!look) return { style: undefined, badge: undefined, card: undefined }
+  const style: Record<string, string> = {}
+  if (look.badge) style['--look-badge'] = SWATCHES[look.badge]
+  if (look.badgeBorder) style['--look-badge-border'] = SWATCHES[look.badgeBorder]
+  if (look.card) style['--look-card'] = SWATCHES[look.card]
+  if (look.cardBorder) style['--look-card-border'] = SWATCHES[look.cardBorder]
+  return {
+    style,
+    badge: { 'look-badge': !!look.badge, 'look-badge-border': !!look.badgeBorder },
+    card: { 'look-card': !!look.card, 'look-card-border': !!look.cardBorder }
+  }
+}
